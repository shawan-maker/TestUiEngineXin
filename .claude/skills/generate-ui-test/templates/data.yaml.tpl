# ============================================================
# 参数化测试数据文件
# ============================================================
# {{data_description}}
#
# 文件结构说明：
#   每个顶层 key 是一个数据集名称（如 dataset_1）
#   数据集内包含 name（描述）和若干字段-值对
#   结构相似但数据不同的用例会引用这些数据实现参数化
#
# 使用方式：
#   在 suite 的 case_refs 中通过 data_binding 引用数据集
#   在 case 的 params 中通过 ${group.field} 引用数据值
#
# 参数化规则：
#   - 步骤相同但输入数据/预期结果不同的用例应提取为数据集
#   - 一个数据集对应一条参数化用例的一次执行
#   - 数据集命名建议：{场景描述}_{编号}（如 login_valid_1）
# ============================================================

# 数据集 1：{{dataset_1_name}}
dataset_1:
  name: "{{dataset_1_name}}"
  {{field_1}}: "{{value_1}}"      # 字段说明
  {{field_2}}: "{{value_2}}"      # 字段说明

# 数据集 2：{{dataset_2_name}}
dataset_2:
  name: "{{dataset_2_name}}"
  {{field_1}}: "{{value_1}}"
  {{field_2}}: "{{value_2}}"

# ... 更多数据集按相同格式添加

# ============================================================
# 页面 URL（⚠️ R4.18 强制：必须是完整 URL）
# ============================================================
# URL 必须从 harvest/probe 结果 JSON 的 "url" 字段直接提取，
# 禁止使用相对路径（如 "/xxx-list"），否则 open_url 会报错：
#   Protocol error: Cannot navigate to invalid URL
#
# ✅ 正确：page_url: "http://100.71.19.25:30101/#/module/page-list"
# ❌ 错误：page_url: "/module/page-list"
# ❌ 错误：page_url: "#/module/page-list"
# ============================================================
